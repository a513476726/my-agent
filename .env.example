# 本地开发用；请复制为 .env 后按需修改，不要提交真实凭据。
POSTGRES_DB=myagent
POSTGRES_USER=myagent
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_MEM_LIMIT=2g

DATABASE_URL=postgresql+psycopg://myagent:change-me@127.0.0.1:5432/myagent
TEST_DATABASE_URL=postgresql+psycopg://myagent:change-me@127.0.0.1:5432/myagent_test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=please-generate-a-long-random-secret

# 知识库网关（由 services/knowledge 读取）
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=change-me
# 需先在 RAGFlow 中配置 Provider 实例；完整 ID 形如 <model>@<instance>@<provider>。
# 火山方舟示例：doubao-embedding-vision-251215@volcengine@VolcEngine
RAGFLOW_EMBEDDING_MODEL=change-me
RAGFLOW_TIMEOUT_SECONDS=30
KNOWLEDGE_BASE_URL=http://127.0.0.1:8001
KNOWLEDGE_TIMEOUT_SECONDS=30
# Docker Compose 内 knowledge 容器访问宿主机 RAGFlow 的地址；本地直连仍用 RAGFLOW_BASE_URL。
RAGFLOW_DOCKER_BASE_URL=http://host.docker.internal:9380

# 智能体模型（火山方舟）
ARK_API_KEY=change-me
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AGENT_MODEL=doubao-seed-2-1-pro-260628
AGENT_MAX_ITERS=8
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096

# LibreChat 等 OpenAI 兼容客户端使用的长期令牌
OPENAI_API_KEY=change-me
MY_AGENT_API_KEY=change-me

TZ=Asia/Shanghai

# Compose 部署
API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g
KNOWLEDGE_MEM_LIMIT=512m
WEB_MEM_LIMIT=128m
WORKSPACE_HOST_PATH=../../workspace
