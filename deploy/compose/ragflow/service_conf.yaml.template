general:
  heartbeat_interval: 3s

api:
  host: 0.0.0.0
  http_port: 9380

admin:
  host: 0.0.0.0
  http_port: 9381

mysql:
  name: '${MYSQL_DBNAME:-rag_flow}'
  user: '${MYSQL_USER:-root}'
  password: '${MYSQL_PASSWORD}'
  host: '${MYSQL_HOST:-mysql}'
  port: ${MYSQL_PORT:-3306}
  max_connections: 200
  stale_timeout: 300
  max_allowed_packet: 1073741824

minio:
  user: '${MINIO_USER}'
  password: '${MINIO_PASSWORD}'
  host: '${MINIO_HOST:-minio}:9000'
  bucket: '${MINIO_BUCKET:-}'
  prefix_path: '${MINIO_PREFIX_PATH:-}'

infinity:
  uri: '${INFINITY_HOST:-infinity}:23817'
  postgres_port: 5432
  db_name: 'default_db'

kvrocks:
  db: 1
  username: '${KVROCKS_USERNAME:-}'
  password: '${REDIS_PASSWORD}'
  host: '${KVROCKS_HOST:-kvrocks}:${KVROCKS_PORT:-6379}'

nats:
  host: '${NATS_HOST:-nats}'
  port: ${NATS_PORT:-4222}

otel:
  host: 0.0.0.0
  port: 4318
  secure: false
  sample_ratio: 1.0
  stdout: false
  enable: false

ingestor:
  mq_type: 'nats'
  max_concurrent_workers: 1
  page_concurrency: 2
  compiler_pool_size: 0

file_syncer:
  max_concurrent_syncs: 2
