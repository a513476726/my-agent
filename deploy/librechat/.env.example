# 复制为 deploy/librechat/.env，不要提交真实值。
LIBRECHAT_PORT=3080
LIBRECHAT_MEM_LIMIT=1g
MONGO_MEM_LIMIT=512m
# 镜像仓库不可达时可替换为 GHCR / 国内镜像。
LIBRECHAT_IMAGE=registry.librechat.ai/librechat-ai/librechat-dev:latest
MONGO_IMAGE=mongo:8.0.20

# 必须与平台根目录 .env 的 OPENAI_API_KEY 一致。
MY_AGENT_API_KEY=change-me

# 首次启动前生成：
# openssl rand -hex 32  # LIBRECHAT_CREDS_KEY / JWT_SECRET / JWT_REFRESH_SECRET
# openssl rand -hex 16  # LIBRECHAT_CREDS_IV
LIBRECHAT_CREDS_KEY=change-me
LIBRECHAT_CREDS_IV=change-me
LIBRECHAT_JWT_SECRET=change-me
LIBRECHAT_JWT_REFRESH_SECRET=change-me

# 首次注册账号时临时设为 true，创建账号后改回 false。
LIBRECHAT_ALLOW_REGISTRATION=false
