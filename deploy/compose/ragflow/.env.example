# 复制为 deploy/compose/ragflow/.env 后填写；该文件不会提交。
MYSQL_PASSWORD=change-me
MINIO_USER=ragflow
MINIO_PASSWORD=change-me
REDIS_PASSWORD=change-me
RAGFLOW_ADMIN_PASSWORD=change-me
RAGFLOW_HTTP_PORT=9380
RAGFLOW_MEM_LIMIT=4g
TZ=Asia/Shanghai

# 超级管理员不能生成 API Key；请创建普通账号后生成，并写入根目录 .env 的 RAGFLOW_API_KEY。

# 可选：网络无法直连 Docker Hub 时改用公共镜像加速地址。
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0.40
# MINIO_IMAGE=docker.m.daocloud.io/pgsty/silo:RELEASE.2026-08-06T00-00-00Z
# KVROCKS_IMAGE=docker.m.daocloud.io/apache/kvrocks:2.16.0
# NATS_IMAGE=docker.m.daocloud.io/library/nats:2.14.2
# INFINITY_IMAGE=docker.m.daocloud.io/infiniflow/infinity:v0.7.4-x64-v3
# RAGFLOW_IMAGE=docker.m.daocloud.io/infiniflow/ragflow:v1.0.0-rc2
