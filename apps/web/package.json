{
  "name": "@my-agent/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "vue-tsc --noEmit",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@my-agent/shared-types": "workspace:*",
    "@vueuse/core": "^11.3.0",
    "ant-design-vue": "^4.2.6",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.19",
    "lucide-vue-next": "^0.447.0",
    "pinia": "^3.0.0",
    "tailwind-merge": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "less": "^4.4.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
